+def get_receipt_date(doc) -> DateTimeLikeObject | None:
+	"""Earliest goods receipt backing this document.
+
+	Where an invoice draws on several receipts the earliest one governs, because
+	the clock in receipt-based regimes runs from delivery and the supplier should
+	not lose days to the buyer's choice of when to invoice.
+	"""
+	if doc.get("doctype") != "Purchase Invoice":
+		return None
+
+	receipts = {d.get("purchase_receipt") for d in (doc.get("items") or []) if d.get("purchase_receipt")}
+	if not receipts:
+		return None
+
+	dates = frappe.get_all(
+		"Purchase Receipt",
+		filters={"name": ("in", list(receipts)), "docstatus": 1},
+		pluck="posting_date",
+	)
+	return min(dates) if dates else None
+
+
